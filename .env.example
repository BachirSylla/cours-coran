# Copier ce fichier en .env.local puis renseigner les valeurs du projet Supabase.
# .env.local n'est jamais versionné.

# --- Client (exposé au navigateur via le préfixe VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Outillage uniquement (SECRET — pas de préfixe VITE_, jamais dans le bundle) ---
# Chaîne de connexion Postgres : dashboard Supabase → « Connect » → « Session pooler ».
# Utilisée par psql et par `supabase gen types --db-url`.
SUPABASE_DB_URL=
